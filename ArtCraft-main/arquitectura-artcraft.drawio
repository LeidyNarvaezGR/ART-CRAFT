        </mxCell>

        <mxCell id="e4" value="&lt;b&gt;GET&lt;/b&gt;&lt;br&gt;/pagar&lt;br&gt;&lt;font color='#555555'&gt;resumen del pedido&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="b2">
          <mxGeometry x="820" y="55" width="200" height="95" as="geometry" />
        </mxCell>

        <mxCell id="e5" value="&lt;font color='#1F3E66'&gt;También: ficha de producto &lt;b&gt;/mostrarproducto/{id}&lt;/b&gt;, catálogo, login y registro&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;dashed=1;" vertex="1" parent="b2">
          <mxGeometry x="40" y="165" width="980" height="35" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="3. CAPA DE LÓGICA &#8212; controladores de Laravel en el servidor" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#8A4B00;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="1050" height="150" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;CarritoController&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;session('carrito') = id × cantidad&lt;br&gt;lo guarda el servidor, no el navegador&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="b3">
          <mxGeometry x="50" y="50" width="470" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;Total automático&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;subtotal + envío $ 10.000 = total&lt;br&gt;el mismo valor en carrito y en pago&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="b3">
          <mxGeometry x="530" y="50" width="470" height="80" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="4. CAPA DE DATOS &#8212; persistencia" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#8C2F2F;spacing=6;" vertex="1" parent="1">
