<mxfile host="app.diagrams.net" agent="ArtCraft" version="24.7.5" type="device">
  <diagram id="arquitectura-artcraft" name="Arquitectura Web y Movil con API">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="890" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="titulo" value="Arquitectura del sistema &#8212; Art Craft (Web + Móvil vía API)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#4A1C0C;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1050" height="40" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="1. CAPA CLIENTE &#8212; quién compra" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#4C6B22;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="75" width="1050" height="160" as="geometry" />
        </mxCell>

        <mxCell id="web" value="&lt;b&gt;Web (navegador)&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;Blade + React 19 · Turbo · CSS&lt;br&gt;Catálogo, fichas, carrito y pago&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="b1">
          <mxGeometry x="50" y="50" width="470" height="90" as="geometry" />
        </mxCell>

        <mxCell id="movil" value="&lt;b&gt;App móvil / móvil web&lt;/b&gt;&lt;br&gt;&lt;font color='#555555'&gt;Misma API desde un teléfono&lt;br&gt;Interfaz responsive (menor a 600 px)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=13;" vertex="1" parent="b1">
          <mxGeometry x="530" y="50" width="470" height="90" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="2. CAPA API &#8212; API REST en Laravel (routes/web.php)" style="rounded=1;whiteSpace=wrap;html=1;container=1;collapsible=0;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;fontColor=#1F3E66;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="265" width="1050" height="215" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="&lt;b&gt;POST&lt;/b&gt;&lt;br&gt;/carritoartesano&lt;br&gt;/agregar&lt;br&gt;&lt;font color='#555555'&gt;producto_id + cantidad&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="b2">
          <mxGeometry x="40" y="55" width="240" height="95" as="geometry" />
        </mxCell>

        <mxCell id="e2" value="&lt;b&gt;POST&lt;/b&gt;&lt;br&gt;/carritoartesano&lt;br&gt;/actualizar&lt;br&gt;&lt;font color='#555555'&gt;suma o resta unidades&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="b2">
          <mxGeometry x="300" y="55" width="240" height="95" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="&lt;b&gt;GET&lt;/b&gt;&lt;br&gt;/carritoartesano&lt;br&gt;&lt;font color='#555555'&gt;lista de productos y&lt;br&gt;subtotales&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="b2">
